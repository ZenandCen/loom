# Required
OPENAI_API_KEY=your-key-here
TAVILY_API_KEY=tvly-...

# Model (optional override)
# LOOM_MODEL_MAIN=qwen/qwen3.8-27b
# LOOM_MODEL_GEMINI=gemini-2.0-flash

# Gemini (nếu dùng)
GEMINI_API_KEY=your-gemini-key-here

# LangSmith
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=Loom

# ─── RAG Configuration ───────────────────────────────────────────
# Embedding (default: Ollama local)
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text:latest
RAG_OLLAMA_URL=http://localhost:11434
# Switch to OpenAI:
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# Vector DB (default: Chroma; set QDRANT_URL or PG_DSN to switch)
# RAG_CHROMA_DIR=./chroma_data
# RAG_QDRANT_URL=http://localhost:6333
# RAG_QDRANT_API_KEY=your-qdrant-key
# RAG_PG_DSN=postgresql://user:pass@localhost:5432/loom

# Chunking
# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=50
# RAG_CHUNKING_STRATEGY=recursive  # recursive | header | parent_child | contextual

# Retrieval
# RAG_RETRIEVAL_K=4
# RAG_MAX_REWRITE_COUNT=2
# RAG_PIPELINE=adaptive  # basic | adaptive | self_rag | multi_source

# Paths
# RAG_DATA_DIR=./data
# RAG_COLLECTION=rag_kb
