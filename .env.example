# Required
OPENAI_API_KEY=your-key-here
TAVILY_API_KEY=tvly-...


# Model (optional override)
LOOM_MODEL_MAIN=qwen/qwen3.8-27b
LOOM_MODEL_GEMINI=gemini-3.5-flash-lite
LOOM_MODEL_VISION=qwen-vl-max

# Planner (qwen routes worker + 3 LLMs vote on best task)
LOOM_PLANNER_ENSEMBLE=1
# 1 = qwen route + gemini/ollama task vote + judge (best quality, slower)
# 0 = qwen only, use its task directly (fast)
LOOM_PLANNER_JUDGE=gemini

# Gemini (nếu dùng)
GEMINI_API_KEY=your-gemini-key-here

# LangSmith
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=Loom

# ─── RAG Configuration ───────────────────────────────────────────
# Embedding model for document vectorization
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text:latest
RAG_OLLAMA_URL=http://localhost:11434

# Vector DB (default: Chroma; set QDRANT_URL or PG_DSN to switch)
# RAG_CHROMA_DIR=./chroma_data
# RAG_QDRANT_URL=http://localhost:6333
# RAG_QDRANT_API_KEY=your-qdrant-key
RAG_PG_DSN=postgresql://postgres:your-password@host:5433/loom

# Chunking
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_CHUNKING_STRATEGY=parent_child
# recursive | header | parent_child | contextual
RAG_PARENT_CHUNK_SIZE=2048
RAG_CHILD_CHUNK_SIZE=256

# Retrieval
RAG_RETRIEVAL_K=8

# Iterative summarization (context window management)
LOOM_CTX_THRESHOLD=30000
LOOM_CTX_WINDOW=8000
LOOM_CTX_MAX_WINDOWS=5
RAG_MAX_REWRITE_COUNT=2
RAG_PIPELINE=adaptive
# basic | adaptive | self_rag | multi_source

# Paths
RAG_DATA_DIR=./data
RAG_COLLECTION=rag_kb
RAG_EVAL_DATASET=./eval_data/eval_questions.json

# ─── MinIO / S3 Storage ───────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=rag-documents
MINIO_USE_SSL=false

# ─── API Server ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Ngrok (tunnel) ───────────────────────────────────────────────────
NGROK_DOMAIN=your-tunnel.ngrok-free.dev
NGROK_AUTHTOKEN=your-ngrok-authtoken

# ─── Slack ─────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_VERIFY=false

# ─── SRE / Monitoring (Grafana, Prometheus, Loki, PMM, GitLab) ──────
# Grafana proxy (Prometheus + Loki via datasource proxy)
GRAFANA_BASE_URL=https://dashboard.prod.fmon.fptcloud.com/loyalty-uat
GRAFANA_USER=your-grafana-user
GRAFANA_PASSWORD=your-grafana-password
PROM_DATASOURCE_ID=1
LOKI_DATASOURCE_ID=2

# PMM (MySQL monitoring)
PMM_URL=http://10.210.14.142
PMM_USER=admin
PMM_PASS=your-pmm-password

# GitLab (self-hosted)
GITLAB_URL=https://gitlab.internal.fpt.com
GITLAB_TOKEN=your-personal-access-token

# Default K8s namespace to monitor
K8S_NAMESPACE=fho-prod
